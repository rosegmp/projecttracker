{
  "name": "project-tracker-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-regression-tests.mjs",
    "test:edge": "node scripts/check-edge-functions.mjs",
    "test:e2e": "playwright test",
    "test:e2e:server": "vite build && vite preview --host 127.0.0.1 --port 4173",
    "test:staging": "node scripts/run-staging-application-tests.mjs",
    "test:backup": "node scripts/test-production-backup.mjs",
    "test:recovery": "node scripts/test-recovery-restore.mjs",
    "test:rollback": "node scripts/test-rollback-readiness.mjs",
    "test:publish": "node scripts/test-publish-netlify-production.mjs",
    "test:db": "supabase test db",
